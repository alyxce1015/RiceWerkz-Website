# Cloudinary – frontend-safe config (these are NOT secrets)
# Vite requires the VITE_ prefix to expose vars to the browser
VITE_CLOUDINARY_CLOUD_NAME=dx1b5cswx
VITE_CLOUDINARY_HERO_TAG=heroSlides
VITE_CLOUDINARY_GALLERY_TAG=gallery
VITE_CLOUDINARY_UPLOAD_PRESET_HERO=hero-upload
VITE_CLOUDINARY_UPLOAD_PRESET_GALLERY=gallery-upload

# API Key and API Secret are NOT stored here.
# They must only be used server-side (e.g. a backend API route or serverless function).
# Never prefix secrets with VITE_ — that would bundle them into the public JS.
